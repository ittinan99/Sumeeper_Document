permanent for the run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="940" width="320" height="110" as="geometry"/></mxCell><mxCell id="47" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="44" target="46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="48" value="Back to grid" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=0.3;" vertex="1" parent="1"><mxGeometry x="100" y="960" width="160" height="50" as="geometry"/></mxCell><mxCell id="49" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="44" target="48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="50" value="curse applied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="46" target="48"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1080"/><mxPoint x="180" y="1080"/></Array></mxGeometry></mxCell><mxCell id="51" value="Combat never stalls: no input during battle. Every started combat ends with a death, so Feast HP is never stored across combats." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="380" height="70" as="geometry"/></mxCell><mxCell id="52" value="Skip battle appears in the Pre-Combat button list (GDD &gt; Combat Encounter) and is also allowed once battle has started. Result is identical to watching." style="shape=note;whiteSpac