Color=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;size=14;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="410" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 - Combat" id="page4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Page 4 - Combat (Pre-Combat -&gt; watch-only auto battle -&gt; result)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="Grid: opened a Feast tile (or hatched an Edemia egg)" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=0.3;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="260" height="50" as="geometry"/></mxCell><mxCell id="4" value="Pre-Combat screen&lt;br&gt;Feast: true tier + identity, scaled stats (In-run Threat), sequence preview, Special&lt;br&gt;Player: HP / DEF / STA, loadout picker (0-3 of 6), meal inventory&lt;br&gt;Boss (endgame only): reminder WILL / WILL NOT enter the vault at this Pre-run Threat&lt;br&gt;[Retreat] [Auto battle x2] [Auto battle x4] [Skip battle] [Meal inventory]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="380" height="130" as="geometry"/></mxCell><mxCell id="5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6" value="Player action" 